					<div class="no-alternate       " data-attr-col1="px" data-attr-hdr="px" data-attr-body="px">
						<table width="100%" cellspacing="0" cellpadding="1" border="1"><tbody><tr><td colspan="3"><b>Pro Kits (8) Modular kits for software development and feature evaluation of IoT devices</b></td></tr><tr><td><a href="https://www.silabs.com/development-tools/wireless/bluetooth/bgm22-pro-kit">BG22-PK6022A</a></td><td>BG22 Bluetooth Dual Polarized Antenna Array Pro Kit</td><td>MSRP $299.00</td></tr><tr><td><a href="https://www.silabs.com/development-tools/wireless/efr32xg24-pro-kit-10-dbm">XG24-PK6009A</a></td><td>EFR32xG24 Pro Kit &#43;10 dBm</td><td>MSRP $179.00</td></tr><tr><td><a href="https://www.silabs.com/development-tools/wireless/efr32xg24-pro-kit-20-dbm">XG24-PK6010A</a></td><td>EFR32xG24 Pro Kit &#43;20 dBm</td><td>MSRP $179.00</td></tr><tr><td><a href="/development-tools/wireless/efr32xg27-pro-kit-8-dbm">XG27-PK6017A</a></td><td>EFR32xG27 Pro Kit &#43;8 dBm</td><td>MSRP $188.00</td></tr><tr><td><a href="/development-tools/wireless/efr32xg27-pro-kit-4-dbm-buck">XG27-PK6018A</a></td><td>EFR32xG27 Pro Kit &#43;4 dBm (Buck)</td><td>MSRP $174.00</td></tr><tr><td><a href="/development-tools/wireless/efr32xg27-pro-kit-4-dbm-boost">XG27-PK6019A</a></td><td>EFR32xG27 Pro Kit &#43;4 dBm (Boost)</td><td>MSRP $176.00</td></tr><tr><td><a href="/development-tools/wireless/efr32xg29-pro-kit-8-dbm-dcdc-buck">XG29-PK6034A</a></td><td>EFR32xG29 Pro Kit &#43;8 dBm DCDC Buck</td><td>MSRP $182.00</td></tr><tr><td><a href="/development-tools/wireless/sixg301-pro-kit">SiXG301-PK6037A</a></td><td>SixG301 Wireless 2.4 GHz &#43;10 dBm 4MB Flash Pro Kit</td><td>MSRP $185.00</td></tr><tr><td colspan="3"><b>Explorer Kits (6) Low cost exploratory kits - to get you started</b></td></tr><tr><td><a href="https://www.silabs.com/development-tools/wireless/bluetooth/bg22-explorer-kit">BG22-EK4108A</a></td><td>BG22 Bluetooth SoC Explorer Kit</td><td>MSRP $16.00</td></tr><tr><td><a href="https://www.silabs.com/development-tools/wireless/bluetooth/bgm220-explorer-kit">BGM220-EK4314A</a></td><td